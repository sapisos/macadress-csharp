<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Macadress</PackageId>
    <Version>1.0.0</Version>
    <Authors>ApisOS FZE</Authors>
    <Description>Official .NET client for the macadress.com MAC address and OUI vendor lookup API.</Description>
    <PackageProjectUrl>https://macadress.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sapisos/macadress-csharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>macadress;mac-address;oui;vendor-lookup;networking</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
